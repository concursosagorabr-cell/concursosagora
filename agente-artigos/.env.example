# Copie para .env.local apenas se precisar sobrescrever as credenciais
# do frontend (../../concursosagora-main/.env.local já é lido automaticamente).

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-25
SANITY_API_TOKEN=
SANITY_API_READ_TOKEN=

# Groq (aceita GROQ_API_KEY, GROQ_API_KEYS, GROQ_WRITER_KEYS)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comportamento editorial (nunca publique automaticamente)
AUTO_PUBLISH=false
MIN_CONTENT_WORDS=200
MAX_ARTICLES_PER_RUN=10
FACT_CHECK_MIN_SCORE=90
FACT_CHECK_TWO_SOURCE_RULE=true
FACT_CHECK_MAX_REPAIR_ATTEMPTS=2
REQUIRE_OFFICIAL_SOURCE=true
REQUIRE_FACT_EVIDENCE=true
BLOCK_ON_FACT_CONFLICT=true
VERIFICATION_MIN_SCORE=95
SCRAPE_INTERVAL_HOURS=2

# Coleta
PIPELINE_RESPECT_ROBOTS=true
PIPELINE_REQUEST_DELAY=1.0
PIPELINE_FETCH_TIMEOUT=60
PIPELINE_MAX_SOURCE_CHARS=14000
PIPELINE_DATA_DIR=
# O DOU não é raspado: importe XML/ZIP oficial baixado manualmente nesta pasta.
DOU_IMPORT_DIR=data/dou
FRONTEND_URL=https://www.concursosagora.com.br