# ============================================================
#  SANITY STUDIO — Concursos Agora
#  Copie para .env.local e preencha os valores.
# ============================================================

SANITY_STUDIO_PROJECT_ID=wobukj4j
SANITY_STUDIO_DATASET=production

# Token com permissão de escrita/edição (usado pelos scripts de manutenção).
# NUNCA versione este arquivo. Na Vercel, use SANITY_API_TOKEN.
SANITY_API_TOKEN=

# URLs do frontend
FRONTEND_URL=https://www.concursosagora.com.br
SANITY_REVALIDATE_SECRET=

# Host do Studio publicado (sanity deploy)
SANITY_STUDIO_HOST=concursos-agora
