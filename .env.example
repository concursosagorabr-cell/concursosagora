# =====================================================================
# Variáveis de Ambiente — Concursos Agora Frontend
# =====================================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# Na Vercel, adicione estas variáveis em:
#   Project Settings → Environment Variables
# =====================================================================

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=seu_project_id_aqui
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-25
# Token de leitura server-side para quando o dataset for configurado como privado
SANITY_API_READ_TOKEN=seu_token_viewer_read_only_aqui
# Segredo para endpoint /api/revalidate (Webhooks do Sanity)
# Use o MESMO valor no webhook criado por: npm run setup:webhook
# (concursos-sanity-backend). Se rotacionar, rode o script novamente.
SANITY_REVALIDATE_SECRET=seu_segredo_revalidacao_aqui

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Brevo (Newsletter)
BREVO_API_KEY=sua_chave_api_brevo_aqui

# Upstash Redis (Contador de Visualizações e Ranking Mais Lidas - Gratuito)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu_token_aqui

# Turso (Fallback SQLite ilimitado para quando Sanity estourar quota - Gratuito 9GB)
TURSO_DATABASE_URL=libsql://concursos-agora-marcomelo.aws-sa-east-1.turso.io
TURSO_AUTH_TOKEN=seu_token_turso_aqui
# Secret para webhook de sync Sanity → Turso (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SANITY_SYNC_SECRET=seu_segredo_sync_aqui
